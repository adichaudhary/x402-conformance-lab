{
  "name": "x402-conformance",
  "version": "0.0.1",
  "description": "Conformance test suite for x402 servers, clients, and facilitators",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run validate:catalog",
    "mock:server": "tsx src/mocks/server/main.ts",
    "grid": "tsx scripts/compat-grid.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "x402-conformance": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "tests/catalog",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adichaudhary/x402-conformance-lab"
  },
  "keywords": [
    "x402",
    "http-402",
    "conformance",
    "stablecoin",
    "payments"
  ]
}
