{
  "$schema": "../../schemas/implementation-config.schema.json",
  "name": "official-typescript-hono",
  "displayName": "Official x402 TypeScript Hono example server",
  "version": "x402-foundation/x402@e95b066 examples/typescript/servers/hono",
  "role": "server",
  "url": "http://localhost:4021",
  "resource": {
    "path": "/weather",
    "method": "GET",
    "paidContentMarker": "\"weather\":\"sunny\""
  },
  "features": [
    "scheme:exact",
    "network:eip155:84532",
    "network:solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1",
    "chain:testnet"
  ],
  "wallet": { "privateKeyEnv": "X402_TEST_PRIVATE_KEY" },
  "notes": "Needs EVM_ADDRESS, SVM_ADDRESS and FACILITATOR_URL set in the example's .env. See docs/running-official-example.md."
}
